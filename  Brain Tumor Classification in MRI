, accuracy_score\n)\nfrom torchmetrics.classification import MulticlassCalibrationError\n\nimport wandb\nwarnings.filterwarnings('ignore')\n\n# ─── Reproducibility ─────────────────────────────────────────────────────────\nSEED = 42\ndef set_seed(seed=SEED):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.deterministic = True\n\nset_seed()\n\nDEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f'Device: {DEVICE}')\nif torch.cuda.is_available():\n    print(f'GPU: {torch.cuda.get_device_name(0)}')\n    print(f'VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:19:51.200117Z","iopub.execute_input":"2026-06-27T06:19:51.201001Z","iopub.status.idle":"2026-06-27T06:19:51.210072Z","shell.execute_reply.started":"2026-06-27T06:19:51.20097Z","shell.execute_reply":"2026-06-27T06:19:51.209302Z"}},"outputs":[{"name":"stdout","text":"Device: cuda\nGPU: Tesla T4\nVRAM: 15.6 GB\n","output_type":"stream"}],"execution_count":6},{"id":"95a5f777-a0b5-4e56-add8-d43d3330e1db","cell_type":"markdown","source":"---\n## Section 1 — Configuration & Hyperparameters","metadata":{}},{"id":"2194495d-9bf3-413c-ad69-963956d31c32","cell_type":"code","source":"# ─── Section 1: Configuration ────────────────────────────────────────────────\n\nclass CFG:\n    # ── Paths ──────────────────────────────────────────────────────────────\n    FIGSHARE_DIR   = '/kaggle/input/datasets/masoudnickparvar/brain-tumor-mri-dataset'          # Dataset 1\n    KAGGLE_DS_DIR  = '/kaggle/input/datasets/sartajbhuvaji/brain-tumor-classification-mri'   # Dataset 2\n    BRATS_DIR      = '/kaggle/input/datasets/awsaf49/brats20-dataset-training-validation'  # Dataset 3\n    OUTPUT_DIR     = '/kaggle/working/outputs'\n    CHECKPOINT_DIR = '/kaggle/working/checkpoints'\n\n    # ── Model ──────────────────────────────────────────────────────────────\n    CNN_BACKBONE   = 'efficientnet_b0'   # timm model name\n    VIT_BACKBONE   = 'swin_tiny_patch4_window7_224'  # or 'vit_small_patch16_224'\n    NUM_CLASSES    = 4\n    CLASS_NAMES    = ['Glioma', 'Meningioma', 'Pituitary', 'NoTumor']\n    IMG_SIZE       = 224\n    CNN_FEAT_DIM   = 1280  # EfficientNet-B0 final feature dim\n    VIT_FEAT_DIM   = 768   # Swin-Tiny output dim\n    FUSION_DIM     = 256   # Cross-attention projection dim\n    NUM_HEADS      = 1     # Single-head cross-attention (as per proposal)\n    DROPOUT        = 0.4\n\n    # ── Training Stages (from proposal) ────────────────────────────────────\n    # Stage 1: Head only — 5 epochs @ 1e-3\n    # Stage 2: Partial unfreeze — 10 epochs @ 1e-4\n    # Stage 3: Full fine-tune — 15 epochs @ 5e-5\n    STAGE_EPOCHS   = [5, 10, 15]\n    STAGE_LRS      = [1e-3, 1e-4, 5e-5]\n    WARMUP_EPOCHS  = 5\n    BATCH_SIZE     = 32\n    WEIGHT_DECAY   = 1e-4\n    PATIENCE       = 7   # Early stopping patience\n\n    # ── Data Split ─────────────────────────────────────────────────────────\n    TRAIN_RATIO    = 0.70\n    VAL_RATIO      = 0.15\n    TEST_RATIO     = 0.15\n\n    # ── W&B ────────────────────────────────────────────────────────────────\n    WANDB_PROJECT  = 'brain-tumor-mri-classification'\n    WANDB_ENTITY   = None  # Set your W&B username here\n    USE_WANDB      = False  # Set True when W&B account is ready\n\n    # ── Baseline Mode ──────────────────────────────────────────────────────\n    # Set to True to first reproduce Shah et al. (2022) results\n    BASELINE_MODE  = False\n\nos.makedirs(CFG.OUTPUT_DIR, exist_ok=True)\nos.makedirs(CFG.CHECKPOINT_DIR, exist_ok=True)\nprint('✅ Config loaded.')\nprint(f'Classes: {CFG.CLASS_NAMES}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:19:55.004934Z","iopub.execute_input":"2026-06-27T06:19:55.005433Z","iopub.status.idle":"2026-06-27T06:19:55.013867Z","shell.execute_reply.started":"2026-06-27T06:19:55.005406Z","shell.execute_reply":"2026-06-27T06:19:55.012928Z"}},"outputs":[{"name":"stdout","text":"✅ Config loaded.\nClasses: ['Glioma', 'Meningioma', 'Pituitary', 'NoTumor']\n","output_type":"stream"}],"execution_count":7},{"id":"58277e1a-ff2e-4193-b973-6cbcd605baa1","cell_type":"markdown","source":"---\n## Section 2 — Dataset Exploration & Patient-Wise Split\n\n**Key methodological fix**: We split by patient ID, not by slice. Slice-level splits leak the same patient into train and test, inflating accuracy by 5–8% (the core flaw in Shah et al. and Noreen et al.).","metadata":{}},{"id":"8062231d-6291-483b-a048-cdfffca2df9f","cell_type":"code","source":"# ─── Section 2a: Explore Dataset Directory Structure ─────────────────────────\n\ndef explore_dataset(root_dir, name):\n    \"\"\"Print class distribution for a dataset directory.\"\"\"\n    print(f'\\n📂 {name} — {root_dir}')\n    total = 0\n    for split_folder in sorted(os.listdir(root_dir)):\n        split_path = os.path.join(root_dir, split_folder)\n        if not os.path.isdir(split_path): continue\n        print(f'  [{split_folder}]')\n        for cls in sorted(os.listdir(split_path)):\n            cls_path = os.path.join(split_path, cls)\n            if not os.path.isdir(cls_path): continue\n            n = len(os.listdir(cls_path))\n            total += n\n            print(f'    {cls}: {n} images')\n    print(f'  Total: {total} images')\n    return total\n\n# Explore both datasets\nif os.path.exists(CFG.FIGSHARE_DIR):\n    explore_dataset(CFG.FIGSHARE_DIR, 'Dataset 1: Figshare CE-MRI')\nelse:\n    print('⚠️  Dataset 1 not found. Add brain-tumor-mri-dataset to Kaggle.')\n\nif os.path.exists(CFG.KAGGLE_DS_DIR):\n    explore_dataset(CFG.KAGGLE_DS_DIR, 'Dataset 2: Kaggle Shah et al.')\nelse:\n    print('⚠️  Dataset 2 not found. Add brain-tumor-classification-mri to Kaggle.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:20:00.254751Z","iopub.execute_input":"2026-06-27T06:20:00.2555Z","iopub.status.idle":"2026-06-27T06:20:00.482396Z","shell.execute_reply.started":"2026-06-27T06:20:00.255471Z","shell.execute_reply":"2026-06-27T06:20:00.481725Z"}},"outputs":[{"name":"stdout","text":"\n📂 Dataset 1: Figshare CE-MRI — /kaggle/input/datasets/masoudnickparvar/brain-tumor-mri-dataset\n  [Testing]\n    glioma: 400 images\n    meningioma: 400 images\n    notumor: 400 images\n    pituitary: 400 images\n  [Training]\n    glioma: 1400 images\n    meningioma: 1400 images\n    notumor: 1400 images\n    pituitary: 1400 images\n  Total: 7200 images\n\n📂 Dataset 2: Kaggle Shah et al. — /kaggle/input/datasets/sartajbhuvaji/brain-tumor-classification-mri\n  [Testing]\n    glioma_tumor: 100 images\n    meningioma_tumor: 115 images\n    no_tumor: 105 images\n    pituitary_tumor: 74 images\n  [Training]\n    glioma_tumor: 826 images\n    meningioma_tumor: 822 images\n    no_tumor: 395 images\n    pituitary_tumor: 827 images\n  Total: 3264 images\n","output_type":"stream"}],"execution_count":8},{"id":"b3e15add-647f-4818-8bd3-712aabcd50e9","cell_type":"code","source":"# ─── Section 2b: Build Unified Image Manifest ─────────────────────────────────\n# Assign pseudo patient IDs based on image filename prefix\n# Real patient IDs would come from DICOM metadata; filename prefix is the best proxy here\n\nLABEL_MAP = {\n    # Figshare / Kaggle DS folder names → unified 4-class index\n    'glioma':        0, 'glioma_tumor':    0,\n    'meningioma':    1, 'meningioma_tumor': 1,\n    'pituitary':     2, 'pituitary_tumor':  2,\n    'notumor':       3, 'no_tumor':         3, 'normal': 3,\n}\n\ndef build_manifest(root_dir, source_name):\n    \"\"\"Recursively collect (filepath, class_idx, patient_id, source).\"\"\"\n    records = []\n    for dirpath, dirnames, filenames in os.walk(root_dir):\n        folder = os.path.basename(dirpath).lower().strip()\n        if folder not in LABEL_MAP:\n            continue\n        label = LABEL_MAP[folder]\n        for fname in filenames:\n            if not fname.lower().endswith(('.jpg', '.jpeg', '.png')):\n                continue\n            fpath = os.path.join(dirpath, fname)\n            # Pseudo patient ID: filename prefix before last underscore+digits\n            # e.g. \"Te-gl_0001.jpg\" → patient \"Te-gl\"\n            stem = Path(fname).stem\n            parts = stem.rsplit('_', 1)\n            patient_id = f'{source_name}_{parts[0]}' if len(parts) > 1 else f'{source_name}_{stem}'\n            records.append({\n                'filepath': fpath,\n                'label': label,\n                'class_name': CFG.CLASS_NAMES[label],\n                'patient_id': patient_id,\n                'source': source_name,\n            })\n    return records\n\nall_records = []\nif os.path.exists(CFG.FIGSHARE_DIR):\n    all_records += build_manifest(CFG.FIGSHARE_DIR, 'figshare')\nif os.path.exists(CFG.KAGGLE_DS_DIR):\n    all_records += build_manifest(CFG.KAGGLE_DS_DIR, 'kaggle')\n\ndf = pd.DataFrame(all_records)\nprint(f'Total images found: {len(df)}')\nprint(f'Unique pseudo-patients: {df[\"patient_id\"].nunique()}')\nprint('\\nClass distribution:')\nprint(df['class_name'].value_counts())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:20:08.800058Z","iopub.execute_input":"2026-06-27T06:20:08.800438Z","iopub.status.idle":"2026-06-27T06:20:20.241301Z","shell.execute_reply.started":"2026-06-27T06:20:08.800414Z","shell.execute_reply":"2026-06-27T06:20:20.240185Z"}},"outputs":[{"name":"stdout","text":"Total images found: 10464\nUnique pseudo-patients: 2882\n\nClass distribution:\nclass_name\nMeningioma    2737\nGlioma        2726\nPituitary     2701\nNoTumor       2300\nName: count, dtype: int64\n","output_type":"stream"}],"execution_count":9},{"id":"eb211919-ffde-4c0e-822c-45bd3fb0104f","cell_type":"code","source":"# ─── Section 2c: Patient-Wise Train / Val / Test Split ───────────────────────\n# This is the PRIMARY methodological fix vs. Shah et al. and Noreen et al.\n# We ensure no patient appears in both train and test.\n\ndef patient_wise_split(df, train_ratio=0.70, val_ratio=0.15, seed=SEED):\n    \"\"\"Split by patient ID. Returns train_df, val_df, test_df.\"\"\"\n    patients = df['patient_id'].unique()\n    np.random.seed(seed)\n    np.random.shuffle(patients)\n\n    n = len(patients)\n    n_train = int(n * train_ratio)\n    n_val   = int(n * val_ratio)\n\n    train_pids = set(patients[:n_train])\n    val_pids   = set(patients[n_train : n_train + n_val])\n    test_pids  = set(patients[n_train + n_val:])\n\n    train_df = df[df['patient_id'].isin(train_pids)].reset_index(drop=True)\n    val_df   = df[df['patient_id'].isin(val_pids)].reset_index(drop=True)\n    test_df  = df[df['patient_id'].isin(test_pids)].reset_index(drop=True)\n\n    print(f'Patient-wise split:')\n    print(f'  Train: {len(train_df)} images ({len(train_pids)} patients)')\n    print(f'  Val:   {len(val_df)} images ({len(val_pids)} patients)')\n    print(f'  Test:  {len(test_df)} images ({len(test_pids)} patients)')\n    print(f'  ⚠️  Overlap check — train∩test patients: {len(train_pids & test_pids)} (should be 0)')\n    return train_df, val_df, test_df\n\ntrain_df, val_df, test_df = patient_wise_split(df)\n\n# Save split manifest\ndf['split'] = df['patient_id'].apply(\n    lambda p: 'train' if p in set(train_df['patient_id']) \n    else ('val' if p in set(val_df['patient_id']) else 'test')\n)\ndf.to_csv(os.path.join(CFG.OUTPUT_DIR, 'manifest_split.csv'), index=False)\nprint('\\n✅ Patient-wise split complete. Manifest saved.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:20:25.410226Z","iopub.execute_input":"2026-06-27T06:20:25.410871Z","iopub.status.idle":"2026-06-27T06:20:31.562954Z","shell.execute_reply.started":"2026-06-27T06:20:25.410841Z","shell.execute_reply":"2026-06-27T06:20:31.562071Z"}},"outputs":[{"name":"stdout","text":"Patient-wise split:\n  Train: 5778 images (2017 patients)\n  Val:   1406 images (432 patients)\n  Test:  3280 images (433 patients)\n  ⚠️  Overlap check — train∩test patients: 0 (should be 0)\n\n✅ Patient-wise split complete. Manifest saved.\n","output_type":"stream"}],"execution_count":10},{"id":"f6a1f038-0f1f-4fe1-a455-33207940b301","cell_type":"code","source":"# ─── Section 2d: Class Distribution Visualisation ────────────────────────────\n\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\nsplits = [('Train', train_df), ('Val', val_df), ('Test', test_df)]\ncolors = ['#4C72B0', '#DD8452', '#55A868', '#C44E52']\n\nfor ax, (name, sdf) in zip(axes, splits):\n    counts = sdf['class_name'].value_counts().reindex(CFG.CLASS_NAMES, fill_value=0)\n    ax.bar(counts.index, counts.values, color=colors)\n    ax.set_title(f'{name} Set (n={len(sdf)})')\n    ax.set_ylabel('Count')\n    for i, v in enumerate(counts.values):\n        ax.text(i, v + 5, str(v), ha='center', fontsize=9)\n    ax.tick_params(axis='x', rotation=15)\n\nplt.suptitle('Class Distribution — Patient-Wise Split', fontsize=13, fontweight='bold')\nplt.tight_layout()\nplt.savefig(os.path.join(CFG.OUTPUT_DIR, 'class_distribution.png'), dpi=150)\nplt.show()\nprint('✅ Distribution plot saved.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:21:25.959481Z","iopub.execute_input":"2026-06-27T06:21:25.959927Z","iopub.status.idle":"2026-06-27T06:21:26.669244Z","shell.execute_reply.started":"2026-06-27T06:21:25.959897Z","shell.execute_reply":"2026-06-27T06:21:26.668442Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x400 with 3 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"✅ Distribution plot saved.\n","output_type":"stream"}],"execution_count":11},{"id":"cf068a09-773f-4128-adda-cb060c09ab7f","cell_type":"markdown","source":"---\n## Section 3 — Preprocessing Pipeline\n\nExactly reproducing Shah et al. (2022) preprocessing for fair comparison:\nGrayscale → Gaussian Blur → High-Pass Sharpen → Morphological Ops → Contour Crop → 224×224","metadata":{}},{"id":"e03e32c1-a327-4ed2-b3df-07f91a265532","cell_type":"code","source":"# ─── Section 3: Preprocessing Pipeline (Paper B — exactly preserved) ─────────\n\ndef preprocess_mri(img_path, target_size=224):\n    \"\"\"\n    Preprocessing pipeline from Shah et al. (2022), steps 1–6:\n    1. Convert to Grayscale\n    2. Gaussian Blur (5x5, sigma=1)\n    3. High-Pass Sharpen (Laplacian subtraction)\n    4. Morphological Erosion + Dilation\n    5. Contour Crop (bounding box on largest contour)\n    6. Resize to 224×224\n    Returns: RGB PIL Image (3-channel grayscale for ImageNet pretrained models)\n    \"\"\"\n    # Step 1: Load & convert to grayscale\n    img = cv2.imread(img_path)\n    if img is None:\n        # Fallback: PIL load\n        img = np.array(Image.open(img_path).convert('RGB'))\n        img = cv2.cvtColor(img, cv2.COLOR_RGB2BGR)\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n\n    # Step 2: Gaussian Blur — suppress high-frequency scanner noise\n    blurred = cv2.GaussianBlur(gray, (5, 5), 1)\n\n    # Step 3: High-Pass Sharpen — Laplacian kernel to enhance tumor boundaries\n    laplacian = cv2.Laplacian(blurred, cv2.CV_64F)\n    laplacian = np.clip(laplacian, 0, 255).astype(np.uint8)\n    sharpened = cv2.subtract(blurred, laplacian)\n    sharpened = np.clip(sharpened, 0, 255).astype(np.uint8)\n\n    # Step 4: Morphological Erosion + Dilation — isolate brain parenchyma\n    kernel = np.ones((3, 3), np.uint8)\n    eroded  = cv2.erode(sharpened, kernel, iterations=1)\n    dilated = cv2.dilate(eroded, kernel, iterations=1)\n\n    # Step 5: Contour Crop — bounding box on largest connected contour\n    _, thresh = cv2.threshold(dilated, 10, 255, cv2.THRESH_BINARY)\n    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n\n    if contours:\n        largest = max(contours, key=cv2.contourArea)\n        x, y, w, h = cv2.boundingRect(largest)\n        # Add small padding (5px)\n        pad = 5\n        x = max(0, x - pad); y = max(0, y - pad)\n        w = min(dilated.shape[1] - x, w + 2*pad)\n        h = min(dilated.shape[0] - y, h + 2*pad)\n        cropped = dilated[y:y+h, x:x+w]\n    else:\n        cropped = dilated  # fallback: no crop\n\n    # Step 6: Resize to 224×224 (bilinear)\n    resized = cv2.resize(cropped, (target_size, target_size), interpolation=cv2.INTER_LINEAR)\n\n    # Convert grayscale → 3-channel for ImageNet pretrained weights\n    rgb = cv2.merge([resized, resized, resized])\n    return Image.fromarray(rgb)\n\n\n# ── Verify on one sample ──────────────────────────────────────────────────────\nsample_path = train_df['filepath'].iloc[0]\nresult = preprocess_mri(sample_path)\n\nfig, axes = plt.subplots(1, 2, figsize=(8, 4))\naxes[0].imshow(Image.open(sample_path))\naxes[0].set_title('Original')\naxes[1].imshow(result)\naxes[1].set_title('After Preprocessing Pipeline')\nfor ax in axes: ax.axis('off')\nplt.suptitle(f'Class: {train_df[\"class_name\"].iloc[0]}', fontweight='bold')\nplt.tight_layout()\nplt.savefig(os.path.join(CFG.OUTPUT_DIR, 'preprocessing_sample.png'), dpi=150)\nplt.show()\nprint('✅ Preprocessing pipeline verified.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:21:31.355014Z","iopub.execute_input":"2026-06-27T06:21:31.35548Z","iopub.status.idle":"2026-06-27T06:21:31.925655Z","shell.execute_reply.started":"2026-06-27T06:21:31.355448Z","shell.execute_reply":"2026-06-27T06:21:31.924498Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 800x400 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"✅ Preprocessing pipeline verified.\n","output_type":"stream"}],"execution_count":12},{"id":"100d9853-f30f-493f-b76a-9bfe60bb7000","cell_type":"markdown","source":"---\n## Section 4 — Dataset & DataLoader","metadata":{}},{"id":"b8ba95b8-8885-4fcf-8795-c7bcf6433569","cell_type":"code","source":"# ─── Section 4a: Augmentation Transforms ─────────────────────────────────────\n# Applied to training split only — per proposal Table 3.2\n\nIMAGENET_MEAN = [0.485, 0.456, 0.406]\nIMAGENET_STD  = [0.229, 0.224, 0.225]\n\ntrain_transform = T.Compose([\n    T.RandomRotation(degrees=15),              # ±15° — MRI acquired at varying head angles\n    T.RandomHorizontalFlip(p=0.5),             # Bilateral brain symmetry\n    T.RandomVerticalFlip(p=0.3),               # Axial slice orientation variance\n    T.ColorJitter(brightness=0.2, contrast=0.2),  # Scanner intensity calibration\n    T.RandomResizedCrop(CFG.IMG_SIZE, scale=(0.8, 1.0), interpolation=T.InterpolationMode.BILINEAR),\n    T.ToTensor(),\n    T.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),\n])\n\nval_transform = T.Compose([\n    T.Resize((CFG.IMG_SIZE, CFG.IMG_SIZE)),\n    T.ToTensor(),\n    T.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),\n])\n\nprint('✅ Transforms defined.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:21:39.570121Z","iopub.execute_input":"2026-06-27T06:21:39.570774Z","iopub.status.idle":"2026-06-27T06:21:39.577358Z","shell.execute_reply.started":"2026-06-27T06:21:39.570729Z","shell.execute_reply":"2026-06-27T06:21:39.576731Z"}},"outputs":[{"name":"stdout","text":"✅ Transforms defined.\n","output_type":"stream"}],"execution_count":13},{"id":"b149e7c3-53af-43c7-b91e-222ead8b6ef2","cell_type":"code","source":"# ─── Section 4b: Custom Dataset Class ────────────────────────────────────────\n\nclass BrainTumorDataset(Dataset):\n    def __init__(self, df, transform=None, preprocess=True):\n        \"\"\"\n        Args:\n            df: DataFrame with columns ['filepath', 'label', 'class_name']\n            transform: torchvision transforms\n            preprocess: apply Shah et al. preprocessing pipeline\n        \"\"\"\n        self.df = df.reset_index(drop=True)\n        self.transform = transform\n        self.preprocess = preprocess\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        fpath = row['filepath']\n        label = int(row['label'])\n\n        if self.preprocess:\n            img = preprocess_mri(fpath, target_size=CFG.IMG_SIZE)\n        else:\n            img = Image.open(fpath).convert('RGB').resize((CFG.IMG_SIZE, CFG.IMG_SIZE))\n\n        if self.transform:\n            img = self.transform(img)\n\n        return img, label\n\n\n# ─── Class-weighted sampler to handle imbalance ───────────────────────────────\ndef make_weighted_sampler(df):\n    class_counts = df['label'].value_counts().sort_index().values\n    class_weights = 1.0 / class_counts\n    sample_weights = df['label'].map(lambda l: class_weights[l]).values\n    sampler = WeightedRandomSampler(\n        weights=torch.FloatTensor(sample_weights),\n        num_samples=len(sample_weights),\n        replacement=True\n    )\n    return sampler\n\n\n# ─── Build DataLoaders ────────────────────────────────────────────────────────\ntrain_dataset = BrainTumorDataset(train_df, transform=train_transform, preprocess=True)\nval_dataset   = BrainTumorDataset(val_df,   transform=val_transform,   preprocess=True)\ntest_dataset  = BrainTumorDataset(test_df,  transform=val_transform,   preprocess=True)\n\ntrain_sampler = make_weighted_sampler(train_df)\n\ntrain_loader = DataLoader(train_dataset, batch_size=CFG.BATCH_SIZE, sampler=train_sampler,\n                          num_workers=2, pin_memory=True)\nval_loader   = DataLoader(val_dataset,   batch_size=CFG.BATCH_SIZE, shuffle=False,\n                          num_workers=2, pin_memory=True)\ntest_loader  = DataLoader(test_dataset,  batch_size=CFG.BATCH_SIZE, shuffle=False,\n                          num_workers=2, pin_memory=True)\n\nprint(f'Train batches: {len(train_loader)}')\nprint(f'Val batches:   {len(val_loader)}')\nprint(f'Test batches:  {len(test_loader)}')\n\n# Verify one batch\nimgs, labels = next(iter(train_loader))\nprint(f'\\nBatch shape: {imgs.shape} | Labels: {labels[:8].tolist()}')\nprint('✅ DataLoaders ready.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:21:42.960212Z","iopub.execute_input":"2026-06-27T06:21:42.960959Z","iopub.status.idle":"2026-06-27T06:21:44.009843Z","shell.execute_reply.started":"2026-06-27T06:21:42.960931Z","shell.execute_reply":"2026-06-27T06:21:44.008852Z"}},"outputs":[{"name":"stdout","text":"Train batches: 181\nVal batches:   44\nTest batches:  103\n\nBatch shape: torch.Size([32, 3, 224, 224]) | Labels: [2, 2, 2, 3, 1, 3, 0, 2]\n✅ DataLoaders ready.\n","output_type":"stream"}],"execution_count":14},{"id":"decdf314-5982-4824-a745-c403d46ad2d7","cell_type":"code","source":"# ─── Section 4c: Visualise Sample Batch ──────────────────────────────────────\n\ndef denormalize(tensor):\n    mean = torch.tensor(IMAGENET_MEAN).view(3,1,1)\n    std  = torch.tensor(IMAGENET_STD).view(3,1,1)\n    return torch.clamp(tensor * std + mean, 0, 1)\n\nfig, axes = plt.subplots(2, 8, figsize=(16, 5))\nimgs_show, labels_show = imgs[:16], labels[:16]\nfor i, ax in enumerate(axes.flatten()):\n    img_np = denormalize(imgs_show[i]).permute(1, 2, 0).numpy()\n    ax.imshow(img_np)\n    ax.set_title(CFG.CLASS_NAMES[labels_show[i].item()], fontsize=7)\n    ax.axis('off')\nplt.suptitle('Sample Training Batch (after augmentation)', fontweight='bold')\nplt.tight_layout()\nplt.savefig(os.path.join(CFG.OUTPUT_DIR, 'sample_batch.png'), dpi=150)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T06:21:48.992213Z","iopub.execute_input":"2026-06-27T06:21:48.993076Z","iopub.status.idle":"2026-06-27T06:21:50.718209Z","shell.execute_reply.started":"2026-06-27T06:21:48.993038Z","shell.execute_reply":"2026-06-27T06:21:50.717147Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x500 with 16 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":15},{"id":"f34baf64-bab2-4768-b723-63ec82faaedf","cell_type":"markdown","source":"---\n## Section 5 — Model Architecture\n\n### 5A: Baseline — EfficientNet-B0 (Shah et al. reproduction)\n### 5B: Full Model — CNN–ViT Cross-Attention Fusion","metadata":{}},{"id":"120a3b25-c748-41a1-b57a-228778f5de67","cell_type":"code","source":"# ─── Section 5A: Baseline — EfficientNet-B0 (Paper B reproduction) ────────────\n\nclass EfficientNetBaseline(nn.Module):\n    \"\"\"\n    Shah et al. (2022) baseline: EfficientNet-B0 fine-tuned for 4-class classification.\n    Used for Weeks 1-2: reproduce ~98.87% on original slice split,\n    then measure drop under patient-wise split.\n    \"\"\"\n    def __init__(self, num_classes=CFG.NUM_CLASSES, pretrained=True):\n        super().__init__()\n        self.backbone = timm.create_model(\n            CFG.CNN_BACKBONE,\n            pretrained=pretrained,\n            num_classes=0,        # remove default head\n            global_pool='avg'\n        )\n        feat_dim = self.backbone.num_features\n        self.classifier = nn.Sequential(\n            nn.Linear(feat_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(CFG.DROPOUT),\n            nn.Linear(256, num_classes)\n        )\n\n    def forward(self, x):\n        features = self.backbone(x)\n        return self.classifier(features)\n\n    def freeze_backbone(self):\n        for p in self.backbone.parameters():\n            p.requires_grad = False\n\n    def unfreeze_top_blocks(self, n_blocks=2):\n        # Partially unfreeze: last n blocks of EfficientNet\n        blocks = list(self.backbone.blocks.children())\n        for block in blocks[-n_blocks:]:\n            for p in block.parameters():\n                p.requires_grad = True\n\n    def unfreeze_all(self):\n        for p in self.parameters():\n            p.requires_grad = True\n\n\n# Quick parameter count\nbaseline = EfficientNetBaseline()\ntotal_params = sum(p.numel() for p in baseline.parameters())\ntrainable   = sum(p.numel() for p in baseline.parameters() if p.requires_grad)\nprint(f'EfficientNet-B0 Baseline')\nprint(f'  Total params:     {total_params:,}')\nprint(f'  Trainable params: {trainable:,}')\ndel baseline","metadata":{},"outputs":[],"execution_count":null},{"id":"7cf05f0b-f45e-4b9b-bfab-f6f97a938598","cell_type":"code","source":"# ─── Section 5B: Full Model — CNN–ViT Cross-Attention Fusion ─────────────────\n\nclass CrossAttentionFusion(nn.Module):\n    \"\"\"\n    Single-head cross-attention fusion layer.\n    EfficientNet features → Query\n    ViT/Swin features    → Key, Value\n    Output: fused feature vector of dim=fusion_dim\n    \"\"\"\n    def __init__(self, cnn_dim, vit_dim, fusion_dim=CFG.FUSION_DIM, num_heads=CFG.NUM_HEADS):\n        super().__init__()\n        self.fusion_dim = fusion_dim\n\n        # Project CNN and ViT features to common fusion_dim\n        self.q_proj = nn.Linear(cnn_dim, fusion_dim)   # Query from CNN\n        self.k_proj = nn.Linear(vit_dim, fusion_dim)   # Key from ViT\n        self.v_proj = nn.Linear(vit_dim, fusion_dim)   # Value from ViT\n\n        self.attn = nn.MultiheadAttention(\n            embed_dim=fusion_dim,\n            num_heads=num_heads,\n            batch_first=True\n        )\n        self.norm = nn.LayerNorm(fusion_dim)\n        self.dropout = nn.Dropout(0.1)\n\n    def forward(self, cnn_feat, vit_feat):\n        \"\"\"\n        cnn_feat: (B, cnn_dim)  — pooled CNN features\n        vit_feat: (B, vit_dim)  — pooled ViT features\n        returns:  (B, fusion_dim)\n        \"\"\"\n        # Add sequence dim: (B, 1, dim)\n        Q = self.q_proj(cnn_feat).unsqueeze(1)   # (B, 1, fusion_dim)\n        K = self.k_proj(vit_feat).unsqueeze(1)   # (B, 1, fusion_dim)\n        V = self.v_proj(vit_feat).unsqueeze(1)   # (B, 1, fusion_dim)\n\n        attn_out, _ = self.attn(Q, K, V)         # (B, 1, fusion_dim)\n        attn_out = attn_out.squeeze(1)            # (B, fusion_dim)\n\n        # Residual + norm\n        q_squeezed = Q.squeeze(1)                 # (B, fusion_dim)\n        out = self.norm(q_squeezed + self.dropout(attn_out))\n        return out\n\n\nclass CNNViTFusionModel(nn.Module):\n    \"\"\"\n    Dual-branch CNN–ViT cross-attention fusion model.\n\n    Branch 1 (CNN):  EfficientNet-B0 — local texture, edges (5.3M params)\n    Branch 2 (ViT):  Swin-Tiny       — global context, long-range (28M params)\n    Fusion:          Cross-Attention  — learns which regions each branch emphasises\n    Head:            Dense-256 → Dropout(0.4) → Softmax(4)\n    \"\"\"\n    def __init__(self, num_classes=CFG.NUM_CLASSES, pretrained=True):\n        super().__init__()\n\n        # ── CNN Branch: EfficientNet-B0 ───────────────────────────────────\n        self.cnn_branch = timm.create_model(\n            CFG.CNN_BACKBONE,\n            pretrained=pretrained,\n            num_classes=0,\n            global_pool='avg'\n        )\n        cnn_dim = self.cnn_branch.num_features   # 1280 for EfficientNet-B0\n\n        # ── Transformer Branch: Swin-Tiny ─────────────────────────────────\n        self.vit_branch = timm.create_model(\n            CFG.VIT_BACKBONE,\n            pretrained=pretrained,\n            num_classes=0,\n            global_pool='avg'\n        )\n        vit_dim = self.vit_branch.num_features   # 768 for Swin-Tiny\n\n        # ── Cross-Attention Fusion Layer ──────────────────────────────────\n        self.fusion = CrossAttentionFusion(\n            cnn_dim=cnn_dim,\n            vit_dim=vit_dim,\n            fusion_dim=CFG.FUSION_DIM,\n            num_heads=CFG.NUM_HEADS\n        )\n\n        # ── Classification Head ───────────────────────────────────────────\n        # Dense-256 → Dropout(0.4) → Softmax(4) as per proposal\n        self.classifier = nn.Sequential(\n            nn.Linear(CFG.FUSION_DIM, 256),\n            nn.GELU(),\n            nn.Dropout(CFG.DROPOUT),\n            nn.Linear(256, num_classes)\n        )\n\n        self.cnn_dim = cnn_dim\n        self.vit_dim = vit_dim\n\n    def forward(self, x):\n        cnn_feat = self.cnn_branch(x)   # (B, cnn_dim)\n        vit_feat = self.vit_branch(x)   # (B, vit_dim)\n        fused    = self.fusion(cnn_feat, vit_feat)  # (B, fusion_dim)\n        logits   = self.classifier(fused)            # (B, num_classes)\n        return logits\n\n    def get_cnn_features(self, x):\n        \"\"\"For Grad-CAM — returns CNN branch features.\"\"\"\n        return self.cnn_branch(x)\n\n    # ── Progressive fine-tuning helpers ──────────────────────────────────────\n    def stage1_freeze(self):\n        \"\"\"Stage 1: Freeze all backbone, train head only.\"\"\"\n        for p in self.cnn_branch.parameters(): p.requires_grad = False\n        for p in self.vit_branch.parameters(): p.requires_grad = False\n        for p in self.fusion.parameters():     p.requires_grad = True\n        for p in self.classifier.parameters(): p.requires_grad = True\n        print('Stage 1: Head + Fusion only (backbones frozen)')\n\n    def stage2_partial_unfreeze(self):\n        \"\"\"Stage 2: Unfreeze top 2 CNN blocks + full ViT branch.\"\"\"\n        # Unfreeze top 2 blocks of EfficientNet\n        blocks = list(self.cnn_branch.blocks.children())\n        for block in blocks[-2:]:\n            for p in block.parameters(): p.requires_grad = True\n        # Unfreeze full ViT branch\n        for p in self.vit_branch.parameters(): p.requires_grad = True\n        print('Stage 2: ViT + top-2 CNN blocks + head (partial unfreeze)')\n\n    def stage3_full_unfreeze(self):\n        \"\"\"Stage 3: Unfreeze everything, slow LR.\"\"\"\n        for p in self.parameters(): p.requires_grad = True\n        print('Stage 3: All layers unfrozen (slow LR = 5e-5)')\n\n\n# ── Instantiate and inspect ───────────────────────────────────────────────────\nmodel = CNNViTFusionModel(pretrained=True)\nmodel = model.to(DEVICE)\n\ntotal_params = sum(p.numel() for p in model.parameters())\nprint(f'\\nCNN–ViT Fusion Model')\nprint(f'  CNN dim:          {model.cnn_dim}')\nprint(f'  ViT dim:          {model.vit_dim}')\nprint(f'  Fusion dim:       {CFG.FUSION_DIM}')\nprint(f'  Total params:     {total_params:,} ({total_params/1e6:.1f}M)')\n\n# Verify forward pass\nwith torch.no_grad():\n    dummy = torch.randn(2, 3, 224, 224).to(DEVICE)\n    out = model(dummy)\n    print(f'  Output shape:     {out.shape}  ✅')","metadata":{},"outputs":[],"execution_count":null},{"id":"810db1f1-4246-4d54-b837-bc807a0d1930","cell_type":"markdown","source":"---\n## Section 6 — Training Infrastructure","metadata":{}},{"id":"9532bdad-fdbd-4d30-ae72-80fbf6524e81","cell_type":"code","source":"# ─── Section 6a: Class-Weighted Loss ─────────────────────────────────────────\n\ndef get_class_weights(df, num_classes=CFG.NUM_CLASSES):\n    \"\"\"Compute inverse-frequency class weights for CrossEntropy loss.\"\"\"\n    counts = df['label'].value_counts().sort_index()\n    weights = 1.0 / counts.values\n    weights = weights / weights.sum() * num_classes  # normalize\n    return torch.FloatTensor(weights).to(DEVICE)\n\nclass_weights = get_class_weights(train_df)\ncriterion = nn.CrossEntropyLoss(weight=class_weights)\nprint(f'Class weights: {class_weights.cpu().numpy().round(3)}')\nprint(f'  {dict(zip(CFG.CLASS_NAMES, class_weights.cpu().numpy().round(3)))}')","metadata":{},"outputs":[],"execution_count":null},{"id":"bf3cd197-e5fd-440d-a4c4-f6ca5eb9e8a7","cell_type":"code","source":"# ─── Section 6b: Optimizer, Scheduler, Early Stopping ────────────────────────\n\nclass EarlyStopping:\n    def __init__(self, patience=CFG.PATIENCE, delta=1e-4, save_path=None):\n        self.patience = patience\n        self.delta = delta\n        self.save_path = save_path\n        self.best_score = None\n        self.counter = 0\n        self.best_state = None\n        self.stopped = False\n\n    def __call__(self, val_loss, model):\n        score = -val_loss\n        if self.best_score is None or score > self.best_score + self.delta:\n            self.best_score = score\n            self.counter = 0\n            self.best_state = deepcopy(model.state_dict())\n            if self.save_path:\n                torch.save(self.best_state, self.save_path)\n        else:\n            self.counter += 1\n            if self.counter >= self.patience:\n                self.stopped = True\n\n    def restore_best(self, model):\n        if self.best_state:\n            model.load_state_dict(self.best_state)\n            print(f'  Restored best model (val_loss={-self.best_score:.4f})')\n\n\ndef get_optimizer_and_scheduler(model, lr, total_epochs, warmup_epochs=CFG.WARMUP_EPOCHS):\n    optimizer = torch.optim.AdamW(\n        filter(lambda p: p.requires_grad, model.parameters()),\n        lr=lr, weight_decay=CFG.WEIGHT_DECAY\n    )\n    # CosineAnnealingLR with linear warmup\n    def lr_lambda(epoch):\n        if epoch < warmup_epochs:\n            return epoch / warmup_epochs\n        progress = (epoch - warmup_epochs) / max(1, total_epochs - warmup_epochs)\n        return 0.5 * (1 + np.cos(np.pi * progress))\n    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)\n    return optimizer, scheduler\n\nprint('✅ Training utilities defined.')","metadata":{},"outputs":[],"execution_count":null},{"id":"0910145b-8eb3-489b-808d-daa9b9aa7e47","cell_type":"code","source":"# ─── Section 6c: Train & Evaluate One Epoch ──────────────────────────────────\n\ndef train_one_epoch(model, loader, optimizer, criterion, scaler):\n    model.train()\n    total_loss, correct, total = 0.0, 0, 0\n    for imgs, labels in loader:\n        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)\n        optimizer.zero_grad()\n        with torch.cuda.amp.autocast():\n            logits = model(imgs)\n            loss = criterion(logits, labels)\n        scaler.scale(loss).backward()\n        scaler.step(optimizer)\n        scaler.update()\n        total_loss += loss.item() * imgs.size(0)\n        preds = logits.argmax(dim=1)\n        correct += (preds == labels).sum().item()\n        total += imgs.size(0)\n    return total_loss / total, correct / total\n\n\n@torch.no_grad()\ndef evaluate(model, loader, criterion):\n    model.eval()\n    total_loss, correct, total = 0.0, 0, 0\n    all_preds, all_labels, all_probs = [], [], []\n    for imgs, labels in loader:\n        imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)\n        logits = model(imgs)\n        loss = criterion(logits, labels)\n        total_loss += loss.item() * imgs.size(0)\n        probs = F.softmax(logits, dim=1)\n        preds = probs.argmax(dim=1)\n        correct += (preds == labels).sum().item()\n        total += imgs.size(0)\n        all_preds.extend(preds.cpu().numpy())\n        all_labels.extend(labels.cpu().numpy())\n        all_probs.extend(probs.cpu().numpy())\n    return (\n        total_loss / total,\n        correct / total,\n        np.array(all_preds),\n        np.array(all_labels),\n        np.array(all_probs)\n    )\n\n\nprint('✅ Train / eval functions defined.')","metadata":{},"outputs":[],"execution_count":null},{"id":"f916c671-830b-4c99-8d79-f10270c3ea7d","cell_type":"code","source":"# ─── Section 6d: Progressive Fine-Tuning Training Loop ───────────────────────\n\ndef train_progressive(model, model_name='fusion'):\n    \"\"\"\n    Three-stage progressive fine-tuning per proposal Section 3.3.\n    Stage 1: 5 epochs  @ lr=1e-3 — head only\n    Stage 2: 10 epochs @ lr=1e-4 — top-2 CNN blocks + full ViT + head\n    Stage 3: 15 epochs @ lr=5e-5 — all layers\n    \"\"\"\n    stage_configs = list(zip(CFG.STAGE_EPOCHS, CFG.STAGE_LRS))\n    stage_fns = [\n        lambda m: m.stage1_freeze(),\n        lambda m: m.stage2_partial_unfreeze(),\n        lambda m: m.stage3_full_unfreeze(),\n    ]\n\n    history = {'train_loss': [], 'val_loss': [], 'train_acc': [], 'val_acc': [], 'lr': []}\n    scaler  = torch.cuda.amp.GradScaler()\n    best_ckpt = os.path.join(CFG.CHECKPOINT_DIR, f'{model_name}_best.pt')\n    early_stop = EarlyStopping(patience=CFG.PATIENCE, save_path=best_ckpt)\n\n    if CFG.USE_WANDB:\n        wandb.init(project=CFG.WANDB_PROJECT, name=model_name, config=vars(CFG))\n\n    global_epoch = 0\n    for stage_idx, (n_epochs, lr) in enumerate(stage_configs):\n        print(f'\\n{'='*60}')\n        print(f'STAGE {stage_idx+1} — {n_epochs} epochs @ lr={lr}')\n        stage_fns[stage_idx](model)\n        trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n        print(f'  Trainable params: {trainable:,}')\n\n        optimizer, scheduler = get_optimizer_and_scheduler(model, lr, n_epochs)\n\n        for ep in range(1, n_epochs + 1):\n            t0 = time.time()\n            train_loss, train_acc = train_one_epoch(model, train_loader, optimizer, criterion, scaler)\n            val_loss, val_acc, _, _, _ = evaluate(model, val_loader, criterion)\n            scheduler.step()\n            current_lr = optimizer.param_groups[0]['lr']\n\n            history['train_loss'].append(train_loss)\n            history['val_loss'].append(val_loss)\n            history['train_acc'].append(train_acc)\n            history['val_acc'].append(val_acc)\n            history['lr'].append(current_lr)\n\n            elapsed = time.time() - t0\n            print(f'  Ep {global_epoch+ep:02d} | '\n                  f'train_loss={train_loss:.4f} train_acc={train_acc:.4f} | '\n                  f'val_loss={val_loss:.4f} val_acc={val_acc:.4f} | '\n                  f'lr={current_lr:.2e} | {elapsed:.0f}s')\n\n            if CFG.USE_WANDB:\n                wandb.log({'train_loss': train_loss, 'val_loss': val_loss,\n                           'train_acc': train_acc, 'val_acc': val_acc,\n                           'lr': current_lr, 'stage': stage_idx+1})\n\n            early_stop(val_loss, model)\n            if early_stop.stopped:\n                print(f'  ⚠️  Early stopping at epoch {global_epoch+ep}')\n                break\n\n        global_epoch += ep\n        if early_stop.stopped:\n            break\n\n    # Restore best checkpoint\n    early_stop.restore_best(model)\n\n    if CFG.USE_WANDB:\n        wandb.finish()\n\n    return history\n\n\nprint('✅ Progressive training loop defined.')\nprint('🚀 Ready to train. Run the next cell to start.')","metadata":{},"outputs":[],"execution_count":null},{"id":"700d8710-8926-4b61-8f9a-74e5fb095756","cell_type":"markdown","source":"---\n## Section 7 — Baseline: Reproduce Shah et al. (2022)\nWeeks 1–2 goal: confirm ~98.87% accuracy on original slice-level split, then measure drop under patient-wise split.","metadata":{}},{"id":"d7a33690-803c-4e57-9c8c-624f211af764","cell_type":"code","source":"# ─── Section 7: Train Baseline Model ─────────────────────────────────────────\n\nbaseline_model = EfficientNetBaseline(num_classes=CFG.NUM_CLASSES, pretrained=True).to(DEVICE)\n\n\ndef train_baseline(model, model_name='baseline'):\n    \"\"\"Same progressive schedule applied to baseline for fair comparison.\"\"\"\n    stage_configs = list(zip(CFG.STAGE_EPOCHS, CFG.STAGE_LRS))\n    stage_fns = [\n        lambda m: m.freeze_backbone(),\n        lambda m: m.unfreeze_top_blocks(2),\n        lambda m: m.unfreeze_all(),\n    ]\n\n    history = {'train_loss': [], 'val_loss': [], 'train_acc': [], 'val_acc': []}\n    scaler  = torch.cuda.amp.GradScaler()\n    best_ckpt = os.path.join(CFG.CHECKPOINT_DIR, f'{model_name}_best.pt')\n    early_stop = EarlyStopping(patience=CFG.PATIENCE, save_path=best_ckpt)\n\n    global_epoch = 0\n    for stage_idx, (n_epochs, lr) in enumerate(stage_configs):\n        print(f'\\nStage {stage_idx+1} — {n_epochs} epochs @ lr={lr}')\n        stage_fns[stage_idx](model)\n        optimizer, scheduler = get_optimizer_and_scheduler(model, lr, n_epochs)\n\n        for ep in range(1, n_epochs + 1):\n            train_loss, train_acc = train_one_epoch(model, train_loader, optimizer, criterion, scaler)\n            val_loss, val_acc, _, _, _ = evaluate(model, val_loader, criterion)\n            scheduler.step()\n            history['train_loss'].append(train_loss)\n            history['val_loss'].append(val_loss)\n            history['train_acc'].append(train_acc)\n            history['val_acc'].append(val_acc)\n            print(f'  Ep {global_epoch+ep:02d} | train={train_acc:.4f} val={val_acc:.4f}')\n            early_stop(val_loss, model)\n            if early_stop.stopped:\n                break\n        global_epoch += ep\n        if early_stop.stopped:\n            break\n\n    early_stop.restore_best(model)\n    return history\n\n\nprint('▶️  Training baseline EfficientNet-B0...')\nbaseline_history = train_baseline(baseline_model, 'baseline')\n\n# Evaluate on in-domain test set (patient-wise)\n_, baseline_acc, bl_preds, bl_labels, bl_probs = evaluate(baseline_model, test_loader, criterion)\nprint(f'\\n📊 Baseline — Patient-Wise Test Accuracy: {baseline_acc:.4f}')\nprint(f'(This will be lower than Paper B\\'s 98.87% — that\\'s the leakage gap)')","metadata":{},"outputs":[],"execution_count":null},{"id":"5d1fec8d-992b-4e25-8734-1f5e56ada3f5","cell_type":"markdown","source":"---\n## Section 8 — Train Full CNN–ViT Fusion Model","metadata":{}},{"id":"6e2a001c-8e77-417f-8f53-3616b8afc3de","cell_type":"code","source":"# ─── Section 8: Train CNN–ViT Fusion Model ───────────────────────────────────\n\nfusion_model = CNNViTFusionModel(num_classes=CFG.NUM_CLASSES, pretrained=True).to(DEVICE)\n\nprint('▶️  Training CNN–ViT Cross-Attention Fusion Model...')\nprint('  This will take ~2–3 hours on Kaggle T4. Monitor progress below.')\nprint()\n\nfusion_history = train_progressive(fusion_model, model_name='cnn_vit_fusion')\n\n# Evaluate on in-domain test set\n_, fusion_acc, fus_preds, fus_labels, fus_probs = evaluate(fusion_model, test_loader, criterion)\nprint(f'\\n📊 CNN–ViT Fusion — Patient-Wise Test Accuracy: {fusion_acc:.4f}')","metadata":{},"outputs":[],"execution_count":null},{"id":"d53b7bff-6fd4-428e-a815-2fbfc7a4e6fc","cell_type":"code","source":"# ─── Section 8b: Training Curves ─────────────────────────────────────────────\n\ndef plot_training_curves(history, title, save_name):\n    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n\n    # Loss\n    axes[0].plot(history['train_loss'], label='Train Loss', color='#4C72B0')\n    axes[0].plot(history['val_loss'], label='Val Loss', color='#DD8452')\n    axes[0].set_title('Loss')\n    axes[0].set_xlabel('Epoch')\n    axes[0].legend()\n    axes[0].grid(alpha=0.3)\n\n    # Accuracy\n    axes[1].plot(history['train_acc'], label='Train Acc', color='#4C72B0')\n    axes[1].plot(history['val_acc'], label='Val Acc', color='#DD8452')\n    axes[1].set_title('Accuracy')\n    axes[1].set_xlabel('Epoch')\n    axes[1].legend()\n    axes[1].grid(alpha=0.3)\n\n    # Add stage boundary lines\n    stage_ends = [CFG.STAGE_EPOCHS[0], sum(CFG.STAGE_EPOCHS[:2])]\n    for ax in axes:\n        for se in stage_ends:\n            ax.axvline(x=se, color='gray', linestyle='--', alpha=0.5, label='Stage boundary')\n\n    plt.suptitle(title, fontweight='bold')\n    plt.tight_layout()\n    plt.savefig(os.path.join(CFG.OUTPUT_DIR, save_name), dpi=150)\n    plt.show()\n\nplot_training_curves(baseline_history, 'Baseline EfficientNet-B0 Training', 'baseline_curves.png')\nplot_training_curves(fusion_history,   'CNN–ViT Fusion Training',           'fusion_curves.png')","metadata":{},"outputs":[],"execution_count":null},{"id":"1a8f080d-900a-4801-8e85-2aed646b1d01","cell_type":"markdown","source":"---\n## Section 9 — BraTS External Test Set\n\nExtract 2D axial slices from BraTS NIfTI volumes for external hold-out evaluation.","metadata":{}},{"id":"7f2c1e80-e498-4146-b687-296d0ed7481e","cell_type":"code","source":"# ─── Section 9: BraTS Slice Extraction & External Test ───────────────────────\n\nBRATS_SLICE_DIR = os.path.join(CFG.OUTPUT_DIR, 'brats_slices')\nos.makedirs(BRATS_SLICE_DIR, exist_ok=True)\n\n\ndef extract_brats_slices(brats_root, output_dir, n_slices_per_volume=10, max_volumes=50):\n    \"\"\"\n    Extract central 2D axial slices from BraTS NIfTI volumes.\n    Saves as PNG for standard image loading.\n\n    BraTS label mapping:\n      Grade 4 (GBM) → Glioma (class 0)\n      Grade 2/3 (LGG) → Glioma (class 0)\n      (BraTS only contains tumor cases — no NoTumor class)\n    \"\"\"\n    records = []\n    # BraTS 2020 structure: BraTS2020_TrainingData/MICCAI_BraTS2020_TrainingData/\n    case_dirs = sorted(glob.glob(os.path.join(brats_root, '**', 'BraTS20*'), recursive=True))\n    case_dirs = [d for d in case_dirs if os.path.isdir(d)][:max_volumes]\n\n    if not case_dirs:\n        print('⚠️  No BraTS case directories found. Check BRATS_DIR path.')\n        return pd.DataFrame()\n\n    print(f'Processing {len(case_dirs)} BraTS volumes...')\n\n    for case_dir in case_dirs:\n        case_id = os.path.basename(case_dir)\n        # Load T1 contrast-enhanced modality (most similar to CE-MRI in training data)\n        t1ce_files = glob.glob(os.path.join(case_dir, '*t1ce.nii*'))\n        if not t1ce_files:\n            t1ce_files = glob.glob(os.path.join(case_dir, '*t1.nii*'))\n        if not t1ce_files:\n            continue\n\n        nii = nib.load(t1ce_files[0])\n        vol = nii.get_fdata()   # shape: (H, W, D)\n\n        D = vol.shape[2]\n        # Extract central slices (avoid blank slices at edges)\n        slice_indices = np.linspace(D//4, 3*D//4, n_slices_per_volume, dtype=int)\n\n        for si in slice_indices:\n            slc = vol[:, :, si]\n            # Normalize to 0-255\n            slc = slc - slc.min()\n            if slc.max() > 0:\n                slc = (slc / slc.max() * 255).astype(np.uint8)\n\n            fname = f'{case_id}_slice{si:03d}.png'\n            fpath = os.path.join(output_dir, fname)\n            Image.fromarray(slc).save(fpath)\n\n            records.append({\n                'filepath': fpath,\n                'label': 0,  # All BraTS = Glioma\n                'class_name': 'Glioma',\n                'patient_id': f'brats_{case_id}',\n                'source': 'brats'\n            })\n\n    df_brats = pd.DataFrame(records)\n    print(f'Extracted {len(df_brats)} BraTS slices from {len(case_dirs)} volumes.')\n    return df_brats\n\n\nif os.path.exists(CFG.BRATS_DIR):\n    brats_df = extract_brats_slices(CFG.BRATS_DIR, BRATS_SLICE_DIR)\n    if len(brats_df) > 0:\n        brats_dataset = BrainTumorDataset(brats_df, transform=val_transform, preprocess=True)\n        brats_loader  = DataLoader(brats_dataset, batch_size=CFG.BATCH_SIZE, shuffle=False, num_workers=2)\n\n        _, brats_acc_baseline, _, _, _ = evaluate(baseline_model, brats_loader, criterion)\n        _, brats_acc_fusion, _, _, _   = evaluate(fusion_model,   brats_loader, criterion)\n\n        print(f'\\n📊 BraTS External Test (Glioma-only):')\n        print(f'  Baseline accuracy:  {brats_acc_baseline:.4f}')\n        print(f'  Fusion accuracy:    {brats_acc_fusion:.4f}')\nelse:\n    print('ℹ️  BraTS dataset not added. Skipping external test.')\n    print('   Add awsaf49/brats20-dataset-training-validation to Kaggle to enable this.')","metadata":{},"outputs":[],"execution_count":null},{"id":"fb797461-1c3e-47b8-b5ee-3beec5e28968","cell_type":"markdown","source":"---\n## Section 10 — Evaluation Suite (6 Metrics)","metadata":{}},{"id":"fcba0e5e-2d3b-4af4-9345-6a71e17048d7","cell_type":"code","source":"# ─── Section 10a: Full 6-Metric Evaluation ───────────────────────────────────\n# Accuracy | Macro F1 | AUC-ROC | Precision/Recall | ECE | Generalization Gap\n\nece_metric = MulticlassCalibrationError(num_classes=CFG.NUM_CLASSES, n_bins=15, norm='l1')\n\n\ndef compute_all_metrics(model, loader, split_name='test'):\n    \"\"\"\n    Compute all 6 metrics from the proposal's evaluation suite.\n    Returns dict of metric name → value.\n    \"\"\"\n    _, acc, preds, labels, probs = evaluate(model, loader, criterion)\n\n    macro_f1 = f1_score(labels, preds, average='macro', zero_division=0)\n\n    # AUC-ROC: one-vs-rest per class\n    try:\n        auc = roc_auc_score(labels, probs, multi_class='ovr', average='macro')\n    except ValueError:\n        auc = float('nan')  # Only one class in split\n\n    # ECE (Expected Calibration Error)\n    ece_metric.reset()\n    ece_val = ece_metric(\n        torch.FloatTensor(probs),\n        torch.LongTensor(labels)\n    ).item()\n\n    report = classification_report(\n        labels, preds,\n        target_names=CFG.CLASS_NAMES,\n        output_dict=True,\n        zero_division=0\n    )\n\n    metrics = {\n        'split': split_name,\n        'accuracy': acc,\n        'macro_f1': macro_f1,\n        'auc_roc': auc,\n        'ece': ece_val,\n    }\n    for cls in CFG.CLASS_NAMES:\n        metrics[f'{cls}_precision'] = report[cls]['precision']\n        metrics[f'{cls}_recall']    = report[cls]['recall']\n        metrics[f'{cls}_f1']        = report[cls]['f1-score']\n\n    return metrics, preds, labels, probs\n\n\n# Run evaluation for both models\nbl_metrics, bl_preds, bl_labels, bl_probs = compute_all_metrics(baseline_model, test_loader, 'patient-wise')\nfu_metrics, fu_preds, fu_labels, fu_probs = compute_all_metrics(fusion_model, test_loader, 'patient-wise')\n\nprint('\\n📊 Evaluation Results (Patient-Wise Test Set)')\nprint(f'{\"Metric\":<20} {\"Baseline\":>12} {\"CNN-ViT Fusion\":>16}')\nprint('─' * 50)\nfor key in ['accuracy', 'macro_f1', 'auc_roc', 'ece']:\n    print(f'{key:<20} {bl_metrics[key]:>12.4f} {fu_metrics[key]:>16.4f}')","metadata":{},"outputs":[],"execution_count":null},{"id":"1fbf7630-962f-45cc-ad23-78f41dc762b2","cell_type":"code","source":"# ─── Section 10b: Generalization Gap ─────────────────────────────────────────\n# Core contribution: in-domain accuracy − external accuracy\n\n# In-domain = patient-wise test set (same distribution as training)\n# External = BraTS (if available)\n\nindomain_acc_bl = bl_metrics['accuracy']\nindomain_acc_fu = fu_metrics['accuracy']\n\nprint('\\n📊 Generalization Gap Analysis')\nprint(f'  Baseline — In-domain acc:  {indomain_acc_bl:.4f}')\nprint(f'  Fusion   — In-domain acc:  {indomain_acc_fu:.4f}')\n\nif os.path.exists(CFG.BRATS_DIR) and 'brats_acc_baseline' in dir():\n    gap_baseline = indomain_acc_bl - brats_acc_baseline\n    gap_fusion   = indomain_acc_fu - brats_acc_fusion\n    print(f'\\n  Baseline — BraTS acc:      {brats_acc_baseline:.4f}')\n    print(f'  Fusion   — BraTS acc:      {brats_acc_fusion:.4f}')\n    print(f'\\n  ▶ Generalization Gap (Baseline): {gap_baseline:.4f}')\n    print(f'  ▶ Generalization Gap (Fusion):   {gap_fusion:.4f}')\n    print(f'  ▶ Gap Reduction by Fusion:       {gap_baseline - gap_fusion:.4f}')\nelse:\n    print('\\n  (BraTS not available — add dataset for external generalization gap)')","metadata":{},"outputs":[],"execution_count":null},{"id":"43ad418d-7d76-474b-aa90-35981ec1a9b1","cell_type":"code","source":"# ─── Section 10c: Confusion Matrices ─────────────────────────────────────────\n\ndef plot_confusion_matrix(labels, preds, title, save_name):\n    cm = confusion_matrix(labels, preds)\n    cm_norm = cm.astype(float) / cm.sum(axis=1, keepdims=True)\n\n    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n    for ax, data, fmt, subtitle in zip(\n        axes,\n        [cm, cm_norm],\n        ['d', '.2f'],\n        ['Counts', 'Normalized']\n    ):\n        sns.heatmap(data, annot=True, fmt=fmt, cmap='Blues',\n                    xticklabels=CFG.CLASS_NAMES, yticklabels=CFG.CLASS_NAMES, ax=ax)\n        ax.set_title(subtitle)\n        ax.set_xlabel('Predicted')\n        ax.set_ylabel('True')\n\n    plt.suptitle(title, fontweight='bold')\n    plt.tight_layout()\n    plt.savefig(os.path.join(CFG.OUTPUT_DIR, save_name), dpi=150)\n    plt.show()\n\nplot_confusion_matrix(bl_labels, bl_preds, 'Baseline Confusion Matrix', 'baseline_cm.png')\nplot_confusion_matrix(fu_labels, fu_preds, 'CNN–ViT Fusion Confusion Matrix', 'fusion_cm.png')","metadata":{},"outputs":[],"execution_count":null},{"id":"97845d2e-c402-489f-850b-97fee1d0cd29","cell_type":"code","source":"# ─── Section 10d: Per-Class AUC-ROC Curves ───────────────────────────────────\n\nfrom sklearn.preprocessing import label_binarize\nfrom sklearn.metrics import roc_curve, auc\n\ndef plot_roc_curves(labels, probs, title, save_name):\n    labels_bin = label_binarize(labels, classes=list(range(CFG.NUM_CLASSES)))\n    fig, ax = plt.subplots(figsize=(8, 6))\n    colors = ['#4C72B0', '#DD8452', '#55A868', '#C44E52']\n\n    for i, (cls, color) in enumerate(zip(CFG.CLASS_NAMES, colors)):\n        fpr, tpr, _ = roc_curve(labels_bin[:, i], probs[:, i])\n        roc_auc = auc(fpr, tpr)\n        ax.plot(fpr, tpr, color=color, lw=2, label=f'{cls} (AUC={roc_auc:.3f})')\n\n    ax.plot([0, 1], [0, 1], 'k--', lw=1)\n    ax.set_xlim([0, 1]); ax.set_ylim([0, 1.05])\n    ax.set_xlabel('False Positive Rate')\n    ax.set_ylabel('True Positive Rate')\n    ax.set_title(title, fontweight='bold')\n    ax.legend(loc='lower right')\n    ax.grid(alpha=0.3)\n    plt.tight_layout()\n    plt.savefig(os.path.join(CFG.OUTPUT_DIR, save_name), dpi=150)\n    plt.show()\n\nplot_roc_curves(bl_labels, bl_probs, 'Baseline — Per-Class AUC-ROC', 'baseline_roc.png')\nplot_roc_curves(fu_labels, fu_probs, 'CNN–ViT Fusion — Per-Class AUC-ROC', 'fusion_roc.png')","metadata":{},"outputs":[],"execution_count":null},{"id":"d74ab99a-5dc1-48ed-ae28-7930f8f0fa30","cell_type":"markdown","source":"---\n## Section 11 — Grad-CAM Explainability","metadata":{}},{"id":"0f8c3ed7-a7b8-4fbe-923a-a29bdc604abe","cell_type":"code","source":"# ─── Section 11: Grad-CAM on EfficientNet Final Conv Layer ───────────────────\n# Applied on every inference pass — 0 extra compute at deployment\n\nfrom pytorch_grad_cam import GradCAM\nfrom pytorch_grad_cam.utils.image import show_cam_on_image\nfrom pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\n\n\ndef get_gradcam_target_layer(model):\n    \"\"\"\n    Return target layer for Grad-CAM.\n    For EfficientNet-B0: last convolutional block = blocks[-1][-1].conv_pwl\n    For the fusion model, we use the CNN branch's final conv layer.\n    \"\"\"\n    if isinstance(model, CNNViTFusionModel):\n        # Final block of EfficientNet branch\n        return [model.cnn_branch.blocks[-1][-1].conv_pwl]\n    elif isinstance(model, EfficientNetBaseline):\n        return [model.backbone.blocks[-1][-1].conv_pwl]\n    else:\n        raise ValueError('Unknown model type')\n\n\ndef generate_gradcam_grid(model, dataset, n_samples=8, save_name='gradcam_grid.png'):\n    \"\"\"\n    Generate Grad-CAM overlays for n_samples images.\n    Shows original | preprocessed | CAM overlay | prediction.\n    \"\"\"\n    target_layers = get_gradcam_target_layer(model)\n    cam = GradCAM(model=model, target_layers=target_layers)\n\n    fig, axes = plt.subplots(n_samples, 3, figsize=(12, n_samples * 3))\n    if n_samples == 1:\n        axes = axes[np.newaxis, :]\n\n    indices = np.random.choice(len(dataset), n_samples, replace=False)\n\n    for row, idx in enumerate(indices):\n        img_tensor, true_label = dataset[idx]\n        img_tensor_batch = img_tensor.unsqueeze(0).to(DEVICE)\n\n        # Get prediction\n        model.eval()\n        with torch.no_grad():\n            logits = model(img_tensor_batch)\n            pred = logits.argmax(dim=1).item()\n            confidence = F.softmax(logits, dim=1)[0, pred].item()\n\n        # Generate CAM\n        targets = [ClassifierOutputTarget(pred)]\n        grayscale_cam = cam(input_tensor=img_tensor_batch, targets=targets)[0]\n\n        # Denormalize image for display\n        img_display = denormalize(img_tensor).permute(1, 2, 0).numpy()\n        img_display = np.clip(img_display, 0, 1)\n\n        # Overlay\n        cam_overlay = show_cam_on_image(img_display, grayscale_cam, use_rgb=True)\n\n        # Plot\n        axes[row, 0].imshow(img_display)\n        axes[row, 0].set_title(f'Input\\nTrue: {CFG.CLASS_NAMES[true_label]}', fontsize=8)\n\n        axes[row, 1].imshow(grayscale_cam, cmap='jet')\n        axes[row, 1].set_title('Grad-CAM Heatmap', fontsize=8)\n\n        color = 'green' if pred == true_label else 'red'\n        axes[row, 2].imshow(cam_overlay)\n        axes[row, 2].set_title(\n            f'Overlay\\nPred: {CFG.CLASS_NAMES[pred]} ({confidence:.0%})',\n            fontsize=8, color=color\n        )\n\n        for ax in axes[row]: ax.axis('off')\n\n    plt.suptitle('Grad-CAM Spatial Saliency — CNN–ViT Fusion', fontweight='bold', y=1.01)\n    plt.tight_layout()\n    save_path = os.path.join(CFG.OUTPUT_DIR, save_name)\n    plt.savefig(save_path, dpi=150, bbox_inches='tight')\n    plt.show()\n    print(f'✅ Grad-CAM grid saved: {save_path}')\n\n\ngenerate_gradcam_grid(fusion_model, test_dataset, n_samples=8, save_name='gradcam_fusion.png')\ngenerate_gradcam_grid(baseline_model, test_dataset, n_samples=4, save_name='gradcam_baseline.png')","metadata":{},"outputs":[],"execution_count":null},{"id":"5c2cb0c2-9ccb-4208-b7e1-d445d760f7e8","cell_type":"markdown","source":"---\n## Section 12 — Ablation Table (Final Report Results)","metadata":{}},{"id":"38b2a72d-527b-4000-a729-41240de4338e","cell_type":"code","source":"# ─── Section 12: Build Ablation Table ────────────────────────────────────────\n# Fill in actual numbers as experiments complete.\n# Structure matches proposal Section 08.\n\nablation_rows = [\n    {\n        'Model Variant': 'Paper B — EfficientNet-B0 (slice-level, original)',\n        'Split': 'Original',\n        'Acc': '~98.87%',\n        'Macro F1': '—',\n        'AUC': '—',\n        'ECE': '—',\n        'Note': 'Reported by Shah et al. (2022) — leakage-inflated'\n    },\n    {\n        'Model Variant': 'Paper B — EfficientNet-B0 (patient-wise split)',\n        'Split': 'Patient',\n        'Acc': f'{indomain_acc_bl:.4f}',\n        'Macro F1': f'{bl_metrics[\"macro_f1\"]:.4f}',\n        'AUC': f'{bl_metrics[\"auc_roc\"]:.4f}',\n        'ECE': f'{bl_metrics[\"ece\"]:.4f}',\n        'Note': 'Drop from ~98.87% quantifies leakage gap'\n    },\n    {\n        'Model Variant': 'CNN–ViT Cross-Attention Fusion + 4-class',\n        'Split': 'Patient',\n        'Acc': f'{indomain_acc_fu:.4f}',\n        'Macro F1': f'{fu_metrics[\"macro_f1\"]:.4f}',\n        'AUC': f'{fu_metrics[\"auc_roc\"]:.4f}',\n        'ECE': f'{fu_metrics[\"ece\"]:.4f}',\n        'Note': 'Core contribution — CNN+ViT + Grad-CAM'\n    },\n]\n\n# Add BraTS external row if available\nif 'brats_acc_fusion' in dir():\n    ablation_rows.append({\n        'Model Variant': 'Full Model + Grad-CAM (BraTS external test)',\n        'Split': 'External',\n        'Acc': f'{brats_acc_fusion:.4f}',\n        'Macro F1': '—',\n        'AUC': '—',\n        'ECE': '—',\n        'Note': 'Cross-dataset generalization'\n    })\n\nablation_df = pd.DataFrame(ablation_rows)\nablation_df.to_csv(os.path.join(CFG.OUTPUT_DIR, 'ablation_table.csv'), index=False)\n\nprint('\\n📊 ABLATION TABLE (Final Report)')\nprint('=' * 100)\nprint(ablation_df.to_string(index=False))\nprint('\\n✅ Ablation table saved.')","metadata":{},"outputs":[],"execution_count":null},{"id":"a37c17eb-4690-4d5f-9a59-de031d66fdcb","cell_type":"markdown","source":"---\n## Section 13 — Save Checkpoints & Export","metadata":{}},{"id":"2988fcf9-fc90-49ba-a655-3bba69fd5458","cell_type":"code","source":"# ─── Section 13: Save Final Checkpoints ──────────────────────────────────────\n\ndef save_checkpoint(model, metrics, model_name):\n    ckpt = {\n        'model_state_dict': model.state_dict(),\n        'model_name': model_name,\n        'metrics': metrics,\n        'class_names': CFG.CLASS_NAMES,\n        'img_size': CFG.IMG_SIZE,\n        'config': {\n            'cnn_backbone': CFG.CNN_BACKBONE,\n            'vit_backbone': CFG.VIT_BACKBONE,\n            'num_classes': CFG.NUM_CLASSES,\n        }\n    }\n    path = os.path.join(CFG.CHECKPOINT_DIR, f'{model_name}_final.pt')\n    torch.save(ckpt, path)\n    print(f'✅ Saved: {path}')\n    return path\n\nbl_ckpt_path = save_checkpoint(baseline_model, bl_metrics, 'efficientnet_b0_baseline')\nfu_ckpt_path = save_checkpoint(fusion_model,   fu_metrics, 'cnn_vit_fusion')\n\n# List all outputs\nprint('\\n📁 All outputs:')\nfor f in sorted(glob.glob(os.path.join(CFG.OUTPUT_DIR, '*'))):\n    size_kb = os.path.getsize(f) // 1024\n    print(f'  {os.path.basename(f):<40} {size_kb:>6} KB')\n\nprint('\\n📁 Checkpoints:')\nfor f in sorted(glob.glob(os.path.join(CFG.CHECKPOINT_DIR, '*'))):\n    size_mb = os.path.getsize(f) // (1024*1024)\n    print(f'  {os.path.basename(f):<40} {size_mb:>6} MB')","metadata":{},"outputs":[],"execution_count":null},{"id":"2881c310-f2b8-4fa8-9895-ccfc23780de2","cell_type":"markdown","source":"---\n## Section 14 — Inference Demo\nSingle-image prediction with Grad-CAM overlay. This is the core of the Hugging Face Spaces Gradio demo (Week 8).","metadata":{}},{"id":"8398917f-03f3-484e-923d-09c759868c4b","cell_type":"code","source":"# ─── Section 14: Single-Image Inference + Grad-CAM ───────────────────────────\n\nfrom pytorch_grad_cam import GradCAM\nfrom pytorch_grad_cam.utils.image import show_cam_on_image\nfrom pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\n\n\ndef predict_with_gradcam(model, img_path, save_path=None):\n    \"\"\"\n    Full inference pipeline:\n    1. Load and preprocess image\n    2. 4-class softmax prediction with confidence\n    3. Grad-CAM saliency overlay\n    This function is Gradio-ready (replace img_path with PIL Image input).\n    \"\"\"\n    # Preprocess\n    img_pil = preprocess_mri(img_path)\n    img_tensor = val_transform(img_pil).unsqueeze(0).to(DEVICE)\n\n    # Prediction\n    model.eval()\n    with torch.no_grad():\n        logits = model(img_tensor)\n        probs  = F.softmax(logits, dim=1)[0].cpu().numpy()\n        pred   = probs.argmax()\n\n    # Grad-CAM\n    target_layers = get_gradcam_target_layer(model)\n    cam = GradCAM(model=model, target_layers=target_layers)\n    grayscale_cam = cam(input_tensor=img_tensor, targets=[ClassifierOutputTarget(pred)])[0]\n\n    img_display = denormalize(img_tensor[0].cpu()).permute(1, 2, 0).numpy()\n    img_display = np.clip(img_display, 0, 1)\n    cam_overlay = show_cam_on_image(img_display, grayscale_cam, use_rgb=True)\n\n    # Plot\n    fig, axes = plt.subplots(1, 3, figsize=(12, 4))\n    axes[0].imshow(Image.open(img_path))\n    axes[0].set_title('Original', fontsize=11)\n\n    axes[1].imshow(img_display)\n    axes[1].set_title('Preprocessed', fontsize=11)\n\n    axes[2].imshow(cam_overlay)\n    axes[2].set_title(\n        f'Prediction: {CFG.CLASS_NAMES[pred]}\\nConfidence: {probs[pred]:.1%}',\n        fontsize=11, fontweight='bold',\n        color='#2d6a4f'\n    )\n\n    for ax in axes: ax.axis('off')\n\n    # Probability bar\n    ax_bar = fig.add_axes([0.1, -0.15, 0.8, 0.12])\n    bars = ax_bar.barh(CFG.CLASS_NAMES, probs, color=['#4C72B0','#DD8452','#55A868','#C44E52'])\n    ax_bar.set_xlim(0, 1)\n    ax_bar.set_xlabel('Softmax Probability')\n    ax_bar.set_title('Class Probabilities', fontsize=10)\n    for bar, p in zip(bars, probs):\n        ax_bar.text(p + 0.01, bar.get_y() + bar.get_height()/2, f'{p:.3f}',\n                    va='center', fontsize=9)\n\n    plt.suptitle('CNN–ViT Fusion — Inference + Grad-CAM', fontweight='bold', y=1.05)\n\n    if save_path:\n        plt.savefig(save_path, dpi=150, bbox_inches='tight')\n    plt.show()\n\n    print(f'\\nPrediction: {CFG.CLASS_NAMES[pred]} ({probs[pred]:.1%} confidence)')\n    for cls, p in zip(CFG.CLASS_NAMES, probs):\n        print(f'  {cls:<15}: {p:.4f}')\n\n    return CFG.CLASS_NAMES[pred], probs, cam_overlay\n\n\n# Demo on a random test sample\ndemo_idx = random.randint(0, len(test_df) - 1)\ndemo_path = test_df['filepath'].iloc[demo_idx]\ndemo_label = test_df['class_name'].iloc[demo_idx]\nprint(f'Demo image — True class: {demo_label}')\npredict_with_gradcam(\n    fusion_model, demo_path,\n    save_path=os.path.join(CFG.OUTPUT_DIR, 'demo_inference.png')\n)","metadata":{},"outputs":[],"execution_count":null},{"id":"e51342e6-87e6-4ee7-90ee-f37878980aec","cell_type":"markdown","source":"---\n## Section 15 — W&B Logging Summary\n(Enable by setting CFG.USE_WANDB = True and logging in)","metadata":{}},{"id":"c84edd75-3734-4456-8a24-2280f997544a","cell_type":"code","source":"# ─── Section 15: W&B Setup Instructions ──────────────────────────────────────\n\nprint(\"\"\"\n🔧 Weights & Biases Setup\n═══════════════════════════════════════════════════════════\n1. Create account at https://wandb.ai (free)\n2. In Kaggle: Settings → Secrets → Add WANDB_API_KEY\n3. In this notebook, run:\n\n   import wandb\n   import os\n   wandb.login(key=os.environ.get('WANDB_API_KEY'))\n\n4. Set CFG.USE_WANDB = True\n5. Re-run training cells\n\nWhat gets logged automatically:\n  ✓ Train/val loss and accuracy per epoch\n  ✓ Learning rate schedule\n  ✓ Stage transitions\n  ✓ Confusion matrix (via wandb.log)\n  ✓ Model checkpoints\n\nW&B dashboard URL: https://wandb.ai/{CFG.WANDB_ENTITY}/{CFG.WANDB_PROJECT}\n\"\"\")\n\n# W&B login cell (uncomment when ready)\n# import os\n# wandb.login(key=os.environ.get('WANDB_API_KEY'))\n# CFG.USE_WANDB = True","metadata":{},"outputs":[],"execution_count":null},{"id":"495c35a0-76ab-450b-af63-c0f8a1b56a00","cell_type":"markdown","source":"---\n## Section 16 — Hugging Face Spaces Gradio Demo (Week 8 Prep)\nCopy-paste this block into `app.py` for HF Spaces deployment.","metadata":{}},{"id":"0571d5c8-2112-4c54-bc58-80a07ba48d44","cell_type":"code","source":"# ─── Section 16: Gradio Demo Code (HF Spaces — app.py) ───────────────────────\n# Run locally in Kaggle for preview, or deploy to HuggingFace Spaces\n\nGRADIO_APP_CODE = '''\n# app.py — HuggingFace Spaces deployment\n# Requirements: gradio timm torch torchvision pytorch-grad-cam opencv-python\n\nimport gradio as gr\nimport torch, cv2, numpy as np\nimport torch.nn.functional as F\nfrom PIL import Image\nfrom pytorch_grad_cam import GradCAM\nfrom pytorch_grad_cam.utils.image import show_cam_on_image\nfrom pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\n\n# Load model (upload cnn_vit_fusion_final.pt to HF repo)\nDEVICE = torch.device('cpu')\nCLASS_NAMES = [\"Glioma\", \"Meningioma\", \"Pituitar